# Generated ML data and outputs. Commit generators and reviewed synthetic
# test fixtures in source/test folders; keep local datasets out of Git.
/ml/data/raw/*
!/ml/data/raw/.gitkeep
!/ml/data/raw/README.md
/ml/data/processed/*
!/ml/data/processed/.gitkeep
!/ml/data/processed/README.md
/ml/data/synthetic/*
!/ml/data/synthetic/.gitkeep
!/ml/data/synthetic/README.md
/ml/models/*
!/ml/models/.gitkeep
!/ml/models/README.md
/ml/reports/*
!/ml/reports/.gitkeep
!/ml/reports/README.md
