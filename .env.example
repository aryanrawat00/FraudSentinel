# Local synthetic development only. Run scripts/init_env.py to generate .env.
APP_ENV=development
DEMO_MODE=true
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=fraudsentinel
POSTGRES_USER=fraudsentinel
# Leave blank in this tracked template; init_env.py generates a random value.
POSTGRES_PASSWORD=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Used only by Vite's server-side development proxy, never sent to the browser.
API_PROXY_TARGET=http://127.0.0.1:8000
